# ============================================================
# Velora — .gitignore
# Covers: Node.js monorepo, TypeScript, Vite, Prisma,
#         Playwright, scan artifacts, and Windows/editor files.
# ============================================================

# ── Dependencies ────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment & Secrets ───────────────────────────────────
# .env.example IS tracked (safe template, no real values).
# All other .env variants are NEVER committed.
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local

# ── Build Output ────────────────────────────────────────────
dist/
build/
out/
.output/

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
*.js.map

# ── Vite ────────────────────────────────────────────────────
.vite/

# ── Prisma generated client ─────────────────────────────────
# The schema.prisma SOURCE FILE is tracked.
# The generated client output is not — regenerated by `prisma generate`.
apps/api/node_modules/.prisma/
apps/api/src/generated/

# ── Playwright ──────────────────────────────────────────────
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/

# ── Scan Artifacts & Screenshot Storage ─────────────────────
# These are runtime outputs, not source code.
uploads/
scan-artifacts/
screenshots/
artifacts/
*.diff.png
*.baseline.png
*.comparison.png

# ── Test Coverage ───────────────────────────────────────────
coverage/
.nyc_output/

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS & Editor Files ────────────────────────────────────────
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code (workspace settings are personal; tracked per preference)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / PyCharm / WebStorm
.idea/
*.iml

# Cursor
.cursor/

# ── Misc ─────────────────────────────────────────────────────
*.local
.cache/
tmp/
temp/
