# ==============================================================
# Velora — Environment Variables Template
# ==============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. Only .env.example is tracked.
#
# Sections:
#   1. Application
#   2. Database
#   3. Authentication (better-auth)
#   4. GitHub OAuth
#   5. Email (Resend)
#   6. AI Provider
#   7. Storage
# ==============================================================


# ── 1. Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173


# ── 2. Database ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://velora_app:replace_with_password@localhost:3306/velora_dev


# ── 3. Authentication (better-auth) ──────────────────────────
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_string
BETTER_AUTH_URL=http://localhost:3001


# ── 4. GitHub OAuth ───────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Homepage URL:       http://localhost:5173
# Callback URL:       http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here


# ── 5. Email (Resend) ─────────────────────────────────────────
# Free tier: https://resend.com — 100 emails/day
# For local development, set EMAIL_MODE=preview to log emails
# instead of sending them. No API key required in preview mode.
EMAIL_MODE=preview
RESEND_API_KEY=re_replace_with_your_resend_api_key
EMAIL_FROM=Velora <noreply@yourdomain.com>


# ── 6. AI Provider ────────────────────────────────────────────
# Provider options: gemini | ollama | none
# 'none' disables AI features gracefully — all other features still work.
AI_PROVIDER=none
# Gemini (free tier): https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
# Ollama (local, optional): https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434


# ── 7. Storage ────────────────────────────────────────────────
# Storage options: local | cloudinary (local is default for development)
STORAGE_TYPE=local
# Local storage path (relative to apps/api)
UPLOAD_DIR=./uploads
