{
  "name": "velora",
  "version": "0.0.0",
  "private": true,
  "description": "AI-Powered Visual Regression & Source-Code Investigation Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"cyan,magenta\" \"npm run dev --workspace=@velora/api\" \"npm run dev --workspace=@velora/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
