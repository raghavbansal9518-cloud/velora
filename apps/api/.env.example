# ==============================================================
# Velora API — Local Environment Variables Template
# ==============================================================
# Copy this file to .env in apps/api/ (or root) and fill in your password.
# NEVER commit the actual .env file with real credentials.
#
# Dedicated local development database: velora_dev
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# ==============================================================

PORT=3001
NODE_ENV=development

DATABASE_URL="mysql://root:REPLACE_WITH_YOUR_LOCAL_MYSQL_PASSWORD@localhost:3306/velora_dev"
